+    value = (int)(*input++ & 0x3ffu);
+    if (value & 0x200) value -= 0x400;
+    coefficients[0] = value * quant[0];
+    while (input < input_end) {
+        unsigned code = *input++;
+        if (code == 0xfe00) break;
+        index += (int)(code >> 10) + 1;
+        if (index > 63) break;
